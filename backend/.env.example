# Copy this file to .env and adjust if needed.

# Default: a local SQLite file, zero setup, no server required.
DATABASE_URL=sqlite:///./healthcare.db

# To use PostgreSQL instead (e.g. via docker-compose up), use:
# DATABASE_URL=postgresql+psycopg2://healthapp:healthapp_pw@localhost:5432/healthcare_exchange

# Never use the development value outside a local prototype.
JWT_SECRET=dev-secret-change-in-production-please
APP_ENV=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
FILE_STORAGE_PATH=./uploads
PUBLIC_API_URL=http://localhost:8000
DOCUMENT_ENCRYPTION_REQUIRED=false
DOCUMENT_ENCRYPTION_KEY=
DOCUMENT_SCAN_REQUIRED=false
DOCUMENT_SCANNER=unavailable
CLAMAV_HOST=
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_SECONDS=10

# Configure only for a deliberate local seed run. Use a unique value with at
# least 16 characters, upper/lowercase, a number, and a symbol; never commit it.
DEMO_SEED_PASSWORD=

# Production one-time administrator bootstrap (pass only to the seed command,
# not to the long-running API process).
# INITIAL_ADMIN_EMAIL=
# INITIAL_ADMIN_NAME=
# INITIAL_ADMIN_PASSWORD=
