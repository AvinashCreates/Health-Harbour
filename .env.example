# Copy to .env before using Docker Compose. Replace these development values
# before exposing the service outside your local machine.
# DB_PASSWORD is embedded in a database URL; generate it as URL-safe hex,
# for example with: openssl rand -hex 32
POSTGRES_PASSWORD=replace-with-random-postgres-admin-password
DB_PASSWORD=replace-with-random-healthapp-password
KEYCLOAK_DB_PASSWORD=replace-with-random-keycloak-db-password
HAPI_DB_PASSWORD=replace-with-random-hapi-db-password
JWT_SECRET=local-development-secret-change-before-deployment-123456
APP_ENV=development
# Seeding credentials are passed only to the one-shot seed command, not the
# backend service. See README.md and run.md for safe local/production setup.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
PUBLIC_API_URL=http://localhost:8000
DOCUMENT_ENCRYPTION_REQUIRED=false
DOCUMENT_ENCRYPTION_KEY=
DOCUMENT_SCAN_REQUIRED=false
DOCUMENT_SCANNER=unavailable
CLAMAV_HOST=
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_SECONDS=10
DB_AUTO_CREATE=0
AUTH_PROVIDER=local
FHIR_MODE=local
FHIR_SERVER_URL=http://hapi:8080/fhir
FHIR_SERVER_BEARER_TOKEN=
KEYCLOAK_ISSUER=http://localhost:8080/realms/healthharbor
KEYCLOAK_JWKS_URL=http://keycloak:8080/realms/healthharbor/protocol/openid-connect/certs
KEYCLOAK_AUDIENCE=healthcare-exchange-api
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=replace-before-use
FABRIC_ENABLED=false
FABRIC_GATEWAY_URL=http://fabric-gateway:8080
FABRIC_GATEWAY_TOKEN=replace-with-a-random-service-token-of-32-plus-bytes
FABRIC_PSEUDONYM_KEY=replace-with-at-least-32-random-bytes
FABRIC_DOCKER_NETWORK=net
FABRIC_MSP_ID=Org1MSP
FABRIC_PEER_ENDPOINT=peer0.org1.example.com:7051
FABRIC_TLS_SERVER_NAME=peer0.org1.example.com
FABRIC_CHANNEL_NAME=mychannel
FABRIC_CHAINCODE_NAME=clinical-provenance
FABRIC_CERT_PATH=./fabric-identity/cert.pem
FABRIC_KEY_PATH=./fabric-identity/key.pem
FABRIC_TLS_CERT_PATH=./fabric-identity/peer-ca.crt
